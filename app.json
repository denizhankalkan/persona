{
  "expo": {
    "name": "Persona",
    "slug": "persona",
    "version": "1.0.0",
    "scheme": "persona",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3EEE3"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mermind.persona",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "Persona",
        "NSPhotoLibraryUsageDescription": "Sahne ekran görüntülerini ve dolap fotoğraflarını eklemek için."
      }
    },
    "android": {
      "package": "com.mermind.persona",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F3EEE3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F3EEE3"
        }
      ],
      "expo-image",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "REPLACE_AFTER_EAS_INIT"
      }
    }
  }
}
